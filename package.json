{
  "name": "octo-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "octo-manager": "dist/cli.js"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "generate": "bash scripts/generate.sh",
    "build:server": "bun node_modules/typescript/bin/tsc",
    "build": "bash scripts/build.sh",
    "start": "bun dist/cli.js",
    "test": "bun test --timeout 30000 test",
    "check": "bash scripts/check.sh",
    "generate:codex": "bun scripts/generate-codex-types.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typebox": "1.3.27",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.4"
}
