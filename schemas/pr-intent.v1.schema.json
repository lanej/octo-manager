{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "requestId",
    "repository",
    "headRef",
    "headSha",
    "baseRef",
    "purpose",
    "validation",
    "draft",
    "owner"
  ],
  "properties": {
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "const": "publish"
        },
        {
          "type": "string",
          "const": "policy"
        }
      ]
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "headRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "headSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "baseRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "result": {
            "anyOf": [
              {
                "type": "string",
                "const": "passed"
              },
              {
                "type": "string",
                "const": "failed"
              },
              {
                "type": "string",
                "const": "not_run"
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "evidenceUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "draft": {
      "type": "boolean"
    },
    "owner": {
      "type": "object",
      "required": [
        "harness",
        "endpoint",
        "sessionId"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "const": "codex"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
