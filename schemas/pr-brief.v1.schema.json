{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "request",
    "baseSha",
    "policyVersion",
    "change",
    "draft"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "request": {
      "type": "object",
      "required": [
        "requestId",
        "repository",
        "headRef",
        "headSha",
        "baseRef",
        "purpose",
        "validation",
        "draft",
        "owner"
      ],
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "publish"
            },
            {
              "type": "string",
              "const": "policy"
            },
            {
              "type": "string",
              "const": "prepare"
            },
            {
              "type": "string",
              "const": "validate"
            }
          ]
        },
        "headRepository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "updateUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "contract": {
          "type": "object",
          "required": [
            "schema_version",
            "pr"
          ],
          "properties": {
            "schema_version": {
              "type": "number",
              "const": 1
            },
            "pr": {
              "type": "object",
              "required": [
                "presentation",
                "complexity",
                "profiles",
                "overrides"
              ],
              "properties": {
                "presentation": {
                  "type": "object",
                  "required": [
                    "layout",
                    "first_artifact_by_prose_word",
                    "diagram_format"
                  ],
                  "properties": {
                    "layout": {
                      "type": "string",
                      "const": "f-pattern"
                    },
                    "first_artifact_by_prose_word": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    },
                    "diagram_format": {
                      "type": "string",
                      "const": "mermaid"
                    }
                  },
                  "additionalProperties": false
                },
                "complexity": {
                  "type": "object",
                  "required": [
                    "weights",
                    "routine_max",
                    "standard_max"
                  ],
                  "properties": {
                    "weights": {
                      "type": "object",
                      "required": [
                        "breadth",
                        "behavior",
                        "coupling",
                        "compatibility",
                        "state_risk"
                      ],
                      "properties": {
                        "breadth": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "behavior": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "coupling": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "compatibility": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "state_risk": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        }
                      },
                      "additionalProperties": false
                    },
                    "routine_max": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "standard_max": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    }
                  },
                  "additionalProperties": false
                },
                "profiles": {
                  "type": "object",
                  "required": [
                    "routine",
                    "standard",
                    "complex"
                  ],
                  "properties": {
                    "routine": {
                      "type": "object",
                      "required": [
                        "max_prose_words",
                        "require_diagram"
                      ],
                      "properties": {
                        "max_prose_words": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "require_diagram": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    "standard": {
                      "type": "object",
                      "required": [
                        "max_prose_words",
                        "require_diagram"
                      ],
                      "properties": {
                        "max_prose_words": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "require_diagram": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    "complex": {
                      "type": "object",
                      "required": [
                        "max_prose_words",
                        "require_diagram"
                      ],
                      "properties": {
                        "max_prose_words": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "require_diagram": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "overrides": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "rule_id",
                      "reason"
                    ],
                    "properties": {
                      "rule_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      }
                    },
                    "additionalProperties": false
                  },
                  "maxItems": 100
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "contractSource": {
          "type": "object",
          "required": [
            "sha256",
            "path"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "blobSha": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "authoredPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "maxItems": 200
            },
            "parseError": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          },
          "additionalProperties": false
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 20
        },
        "description": {
          "type": "object",
          "required": [
            "title",
            "body"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60000
            }
          },
          "additionalProperties": false
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 200
        },
        "headRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "baseRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "problem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command",
              "result"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "result": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "passed"
                  },
                  {
                    "type": "string",
                    "const": "failed"
                  },
                  {
                    "type": "string",
                    "const": "not_run"
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  }
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "evidenceUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "draft": {
          "type": "boolean"
        },
        "owner": {
          "type": "object",
          "required": [
            "harness",
            "endpoint",
            "sessionId"
          ],
          "properties": {
            "harness": {
              "type": "string",
              "const": "codex"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "additionalProperties": false
        }
      }
    },
    "baseSha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "change": {
      "type": "object",
      "required": [
        "tier",
        "rationale",
        "outcome",
        "claims",
        "limitations",
        "blockers"
      ],
      "properties": {
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "factor",
              "rating",
              "rationale",
              "evidenceRefs"
            ],
            "properties": {
              "factor": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "breadth"
                  },
                  {
                    "type": "string",
                    "const": "behavior"
                  },
                  {
                    "type": "string",
                    "const": "coupling"
                  },
                  {
                    "type": "string",
                    "const": "compatibility"
                  },
                  {
                    "type": "string",
                    "const": "state_risk"
                  }
                ]
              },
              "rating": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "minItems": 1,
                "maxItems": 30
              }
            },
            "additionalProperties": false
          },
          "minItems": 5,
          "maxItems": 5
        },
        "tier": {
          "enum": [
            "routine",
            "standard",
            "complex"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "falsification",
              "evidenceRefs",
              "basis"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "falsification": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "maxItems": 100
              },
              "basis": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "reported"
                  },
                  {
                    "type": "string",
                    "const": "observed"
                  },
                  {
                    "type": "string",
                    "const": "unverified"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "maxItems": 30
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "maxItems": 30
        }
      },
      "additionalProperties": false
    },
    "draft": {
      "type": "object",
      "required": [
        "title",
        "body",
        "requirementChecks",
        "blockers"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60000
        },
        "requirementChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ruleId",
              "status",
              "rationale"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "satisfied"
                  },
                  {
                    "type": "string",
                    "const": "unmet"
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  },
                  {
                    "type": "string",
                    "const": "not_applicable"
                  }
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            },
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "maxItems": 30
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
